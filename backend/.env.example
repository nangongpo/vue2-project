NODE_ENV=development
ENABLE_HTTPS=false
ENABLE_CSP=false
PORT=3000
DATABASE_URL=mysql://app_user:change-me@127.0.0.1:3306/vue2_project_db
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
COOKIE_SECURE=false
COOKIE_DOMAIN=
CSRF_ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_HTTPS_ORIGIN=
TRUST_PROXY=false
SESSION_TTL_SECONDS=1800
SESSION_IDLE_TTL_SECONDS=1800
# Maximum active sessions per user (1–100); oldest excess sessions are revoked on login.
SESSION_MAX_CONCURRENT=3
API_RATE_LIMIT=120
API_RATE_WINDOW_SECONDS=60
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
IDEMPOTENCY_LOCK_SECONDS=15
LOGIN_CAPTCHA_FAILURE_LIMIT=3
CAPTCHA_SERVICE_URL=http://127.0.0.1:3100
CAPTCHA_SERVICE_ID=backend-admin
CAPTCHA_SERVICE_SECRET=replace-with-the-same-long-random-secret-as-captcha-service
CAPTCHA_SERVICE_TIMEOUT_MS=2000
LOG_LEVEL=info
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=请替换为至少12位的强密码
# MFA AES-256-GCM encryption key: base64 of 32 cryptographically random bytes.
# Store in a secret manager; losing this key requires a controlled MFA recovery.
MFA_ENCRYPTION_KEY=
# Separate natural persons must hold security approval and audit duties.
SEED_SECURITY_REVIEWER_USERNAME=
SEED_SECURITY_REVIEWER_PASSWORD=
SEED_AUDIT_USERNAME=
SEED_AUDIT_PASSWORD=
SEED_SYSTEM_USERNAME=
SEED_SYSTEM_PASSWORD=
# HMAC secret shared only with the controlled emergency execution agent.
OPS_EXECUTION_SIGNING_SECRET=
