{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "dev": "node --conditions=development node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "node --conditions=development --import tsx src/database/seed.ts",
    "permission:verify": "pnpm build && node scripts/verify-permission-migration.js",
    "permission:fields": "node --conditions=development --import tsx src/scripts/generate-data-fields.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "8.2.0",
    "@prisma/client": "6.19.3",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-fastify": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "fastify": "5.11.3",
    "joi": "18.2.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "3.2.7",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vitest": "3.2.7",
    "prisma": "6.19.3"
  }
}
