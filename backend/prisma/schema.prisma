generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum RoleStatus {
  ACTIVE
  DISABLED
}

enum RoleType {
  BUSINESS
  SYSTEM
  SECURITY
  AUDIT
}

enum PermissionStatus {
  ACTIVE
  DISABLED
}

enum PageNodeType {
  DIRECTORY
  PAGE
}

enum StandardDataScopeType {
  SELF
  DEPARTMENT_SELF
  DEPARTMENT_TREE
  ORGANIZATION_SELF
  ORGANIZATION_TREE
  TENANT
}

enum ElevatedDataScopeType {
  CUSTOM
  ALL
}

enum DataScopeTargetType {
  USER
  DEPARTMENT
  ORGANIZATION
  TENANT
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum RiskLevel {
  L0
  L1
  L2
  L3
}

enum OperationPolicyStatus {
  DRAFT
  PENDING
  ACTIVE
  DISABLED
}

enum PermissionType {
  PAGE
  BUTTON
  API
  MANAGEMENT
  FIELD
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum FieldRiskLevel {
  L0
  L1
  L2
  L3
}

enum OpsTicketType {
  MFA_RESET_EMERGENCY
  DB_MANUAL_FIX
  PERMISSION_RECOVERY
  ACCOUNT_RECOVERY
  OTHER
}

enum OpsTicketStatus {
  DRAFT
  SUBMITTED
  APPROVED
  EXECUTED
  REVIEWED
  REJECTED
  CANCELLED
}

enum OpsRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OpsTargetType {
  USER
  ROLE
  PERMISSION
  DATABASE
  SYSTEM
  OTHER
}

enum OpsEvidenceType {
  APPROVAL_SCREENSHOT
  EMAIL
  CHAT
  SQL_REVIEW
  OTHER
}

enum OpsExecutionResult {
  SUCCESS
  FAILED
}

enum SessionKind {
  PRE_AUTH
  AUTHENTICATED
}

model User {
  id                BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  userId            String                        @unique @default(uuid()) @map("user_id") @db.Char(36)
  username          String                        @unique @db.VarChar(64)
  password          String                        @db.VarChar(255)
  passwordChangedAt DateTime?                     @map("password_changed_at")
  passwordHistory   PasswordHistory[]
  displayName       String                        @map("display_name") @db.VarChar(128)
  status            UserStatus                    @default(ACTIVE)
  failedLogins      Int                           @default(0) @map("failed_logins")
  lockedUntil       DateTime?                     @map("locked_until")
  lastLoginAt       DateTime?                     @map("last_login_at")
  lastLoginIp       String?                       @map("last_login_ip") @db.VarChar(64)
  expiresAt         DateTime?                     @map("expires_at")
  // Database CHECK constraint is maintained in the migration:
  // mfaEnabled = false requires mfaSecret IS NULL; mfaEnabled = true requires it to be non-null.
  mfaSecret         String?                       @map("mfa_secret") @db.VarChar(512)
  mfaEnabled        Boolean                       @default(false) @map("mfa_enabled")
  mfaLastStep       BigInt?                       @map("mfa_last_step")
  tenantId          String?                       @map("tenant_id") @db.Char(36)
  departmentId      String?                       @map("department_id") @db.Char(36)
  organizationId    String?                       @map("organization_id") @db.Char(36)
  tenant            Tenant?                       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organization      Organization?                 @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  department        Department?                   @relation(fields: [departmentId, tenantId, organizationId], references: [id, tenantId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @updatedAt @map("updated_at")
  roles             UserRole[]
  sessions          Session[]
  audits            AuditLog[]                    @relation("AuditActor")
  elevatedTargets   RoleElevatedDataScopeTarget[] @relation("ElevatedUserTarget")
  orders            Order[]

  @@index([status])
  @@map("sys_user")
}

// 业务订单域：对外使用不可预测的订单编号，内部主键仅用于关联。
model Order {
  id             BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  orderId        String      @unique @default(uuid()) @map("order_id") @db.Char(36)
  orderNo        String      @unique @map("order_no") @db.VarChar(40)
  tenantId       String?     @map("tenant_id") @db.Char(36)
  ownerId        String      @map("owner_id") @db.Char(36)
  departmentId   String?     @map("department_id") @db.Char(36)
  organizationId String?     @map("organization_id") @db.Char(36)
  customerName   String      @map("customer_name") @db.VarChar(128)
  totalAmount    Decimal     @map("total_amount") @db.Decimal(18, 2)
  currency       String      @default("CNY") @db.Char(3)
  status         OrderStatus @default(DRAFT)
  remark         String?     @db.VarChar(500)
  createdBy      String      @map("created_by") @db.Char(36)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  tenant         Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner          User        @relation(fields: [ownerId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([ownerId, createdAt])
  @@map("biz_order")
}

model PasswordHistory {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt, id])
  @@map("sys_password_history")
}

model Role {
  id                 BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  roleId             String                  @unique @default(uuid()) @map("role_id") @db.Char(36)
  code               String                  @unique @db.VarChar(64)
  name               String                  @db.VarChar(128)
  description        String?                 @db.VarChar(255)
  roleType           RoleType                @default(BUSINESS) @map("role_type")
  status             RoleStatus              @default(ACTIVE)
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  users              UserRole[]
  permissions        RolePermission[]
  dataScopes         RoleDataScope[]
  elevatedDataScopes RoleElevatedDataScope[]

  @@index([roleType, status])
  @@map("sys_role")
}

model Permission {
  id                    String               @id @default(uuid()) @db.Char(36)
  code                  String               @unique @db.VarChar(128)
  name                  String               @db.VarChar(128)
  resource              String               @db.VarChar(128)
  action                String               @db.VarChar(64)
  type                  PermissionType       @default(API)
  status                PermissionStatus     @default(ACTIVE)
  method                String?              @db.VarChar(16)
  path                  String?              @db.VarChar(255)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  roles                 RolePermission[]
  roleTypes             PermissionRoleType[]
  functionPermission    SystemFunction?      @relation("FunctionPermission")
  buttonPermission      FunctionButton?      @relation("ButtonPermission")
  functionApis          FunctionApi[]        @relation("FunctionApiPermission")
  buttonApis            ButtonApi[]          @relation("ButtonApiPermission")
  fieldReadDefinitions  PermissionField[]    @relation("FieldReadPermission")
  fieldWriteDefinitions PermissionField[]    @relation("FieldWritePermission")

  @@unique([method, path])
  @@index([resource, action])
  @@index([type, status])
  @@index([status])
  @@map("sys_permission")
}

// Explicit role-type audience for a permission. This relation is the
// authoritative allow-list used by seed, management flows and runtime auth.
model PermissionRoleType {
  permissionId String     @map("permission_id") @db.Char(36)
  roleType     RoleType   @map("role_type")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([permissionId, roleType])
  @@index([roleType, permissionId])
  @@map("sys_permission_role_type")
}

model DataResource {
  id          String           @id @default(uuid()) @db.Char(36)
  code        String           @unique @db.VarChar(128)
  name        String           @db.VarChar(128)
  description String?          @db.VarChar(255)
  status      PermissionStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  roleDataScopes     RoleDataScope[]
  elevatedDataScopes RoleElevatedDataScope[]

  @@index([status, code])
  @@map("sys_data_resource")
}

model PermissionField {
  id                String           @id @default(uuid()) @db.Char(36)
  resource          String           @db.VarChar(128)
  field             String           @db.VarChar(128)
  name              String           @db.VarChar(128)
  dataType          String           @map("data_type") @db.VarChar(32)
  relationResource  String?          @map("relation_resource") @db.VarChar(128)
  relationModel     String?          @map("relation_model") @db.VarChar(128)
  relationField     String?          @map("relation_field") @db.VarChar(128)
  riskLevel         FieldRiskLevel   @default(L1) @map("risk_level")
  status            PermissionStatus @default(ACTIVE)
  readPermissionId  String           @map("read_permission_id") @db.Char(36)
  writePermissionId String?          @map("write_permission_id") @db.Char(36)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  readPermission    Permission       @relation("FieldReadPermission", fields: [readPermissionId], references: [id], onDelete: Restrict)
  writePermission   Permission?      @relation("FieldWritePermission", fields: [writePermissionId], references: [id], onDelete: Restrict)

  @@unique([resource, field])
  @@index([resource, status])
  @@map("sys_permission_field")
}

model SystemFunction {
  id           String           @id @default(uuid()) @db.Char(36)
  code         String           @unique @db.VarChar(128)
  name         String           @db.VarChar(128)
  route        String           @unique @db.VarChar(255)
  component    String?          @db.VarChar(255)
  icon         String?          @db.VarChar(128)
  routeProps   Json?            @map("route_props")
  nodeType     PageNodeType     @default(PAGE) @map("node_type")
  parentId     String?          @map("parent_id") @db.Char(36)
  sort         Int              @default(0)
  status       PermissionStatus @default(ACTIVE)
  permissionId String?          @unique @map("permission_id") @db.Char(36)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  parent       SystemFunction?  @relation("FunctionTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children     SystemFunction[] @relation("FunctionTree")
  permission   Permission?      @relation("FunctionPermission", fields: [permissionId], references: [id], onDelete: Restrict)
  buttons      FunctionButton[]
  apis         FunctionApi[]

  @@index([parentId, sort])
  @@index([status])
  @@map("sys_function")
}

model FunctionButton {
  id           String           @id @default(uuid()) @db.Char(36)
  functionId   String           @map("function_id") @db.Char(36)
  code         String           @unique @db.VarChar(128)
  name         String           @db.VarChar(128)
  label        String           @db.VarChar(128)
  sort         Int              @default(0)
  status       PermissionStatus @default(ACTIVE)
  permissionId String?          @unique @map("permission_id") @db.Char(36)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  function     SystemFunction   @relation(fields: [functionId], references: [id], onDelete: Restrict)
  permission   Permission?      @relation("ButtonPermission", fields: [permissionId], references: [id], onDelete: Restrict)
  apis         ButtonApi[]

  @@index([functionId, sort])
  @@map("sys_function_button")
}

model FunctionApi {
  functionId String         @map("function_id") @db.Char(36)
  apiId      String         @map("api_id") @db.Char(36)
  required   Boolean        @default(true)
  function   SystemFunction @relation(fields: [functionId], references: [id], onDelete: Restrict)
  api        Permission     @relation("FunctionApiPermission", fields: [apiId], references: [id], onDelete: Restrict)

  @@id([functionId, apiId])
  @@map("sys_function_api")
}

model ButtonApi {
  buttonId String         @map("button_id") @db.Char(36)
  apiId    String         @map("api_id") @db.Char(36)
  button   FunctionButton @relation(fields: [buttonId], references: [id], onDelete: Restrict)
  api      Permission     @relation("ButtonApiPermission", fields: [apiId], references: [id], onDelete: Restrict)

  @@id([buttonId, apiId])
  @@map("sys_button_api")
}

model UserRole {
  userId       BigInt    @map("user_id") @db.UnsignedBigInt
  roleId       BigInt    @map("role_id") @db.UnsignedBigInt
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  expiresAt    DateTime? @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  grantedBy    String?   @map("granted_by") @db.Char(36)
  revokedBy    String?   @map("revoked_by") @db.Char(36)
  grantReason  String?   @map("grant_reason") @db.VarChar(255)
  revokeReason String?   @map("revoke_reason") @db.VarChar(255)
  approvalRef  String?   @map("approval_ref") @db.Char(36)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId, revokedAt, expiresAt])
  @@map("sys_user_role")
}

model RolePermission {
  roleId       BigInt     @map("role_id") @db.UnsignedBigInt
  permissionId String     @map("permission_id") @db.Char(36)
  assignedAt   DateTime   @default(now()) @map("assigned_at")
  expiresAt    DateTime?  @map("expires_at")
  revokedAt    DateTime?  @map("revoked_at")
  grantedBy    String?    @map("granted_by") @db.Char(36)
  revokedBy    String?    @map("revoked_by") @db.Char(36)
  grantReason  String?    @map("grant_reason") @db.VarChar(255)
  revokeReason String?    @map("revoke_reason") @db.VarChar(255)
  approvalRef  String?    @map("approval_ref") @db.Char(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId, revokedAt, expiresAt])
  @@map("sys_role_permission")
}

model RoleDataScope {
  id                 String                @id @default(uuid()) @db.Char(36)
  roleId             BigInt                @map("role_id") @db.UnsignedBigInt
  resource           String                @db.VarChar(128)
  scopeType          StandardDataScopeType @map("scope_type")
  expiresAt          DateTime?             @map("expires_at")
  revokedAt          DateTime?             @map("revoked_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  role               Role                  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  resourceDefinition DataResource          @relation(fields: [resource], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@index([roleId, scopeType, revokedAt, expiresAt])
  @@map("sys_role_data_scope")
}

model RoleElevatedDataScope {
  id                 String                        @id @default(uuid()) @db.Char(36)
  roleId             BigInt                        @map("role_id") @db.UnsignedBigInt
  resource           String                        @db.VarChar(128)
  scopeType          ElevatedDataScopeType         @map("scope_type")
  reason             String                        @db.VarChar(255)
  approvalRef        String                        @map("approval_ref") @db.Char(36)
  validFrom          DateTime                      @default(now()) @map("valid_from")
  expiresAt          DateTime                      @map("expires_at")
  revokedAt          DateTime?                     @map("revoked_at")
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")
  role               Role                          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  resourceDefinition DataResource                  @relation(fields: [resource], references: [code], onDelete: Restrict, onUpdate: Restrict)
  targets            RoleElevatedDataScopeTarget[]

  @@index([roleId, scopeType, revokedAt, expiresAt])
  @@map("sys_role_elevated_data_scope")
}

model RoleElevatedDataScopeTarget {
  id                   String                @id @default(uuid()) @db.Char(36)
  elevatedScopeId      String                @map("elevated_scope_id") @db.Char(36)
  targetType           DataScopeTargetType   @map("target_type")
  targetId             String                @map("target_id") @db.Char(36)
  targetUserId         String?               @map("target_user_id") @db.Char(36)
  targetDepartmentId   String?               @map("target_department_id") @db.Char(36)
  targetOrganizationId String?               @map("target_organization_id") @db.Char(36)
  targetTenantId       String?               @map("target_tenant_id") @db.Char(36)
  targetUser           User?                 @relation("ElevatedUserTarget", fields: [targetUserId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  targetDepartment     Department?           @relation(fields: [targetDepartmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetOrganization   Organization?         @relation(fields: [targetOrganizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetTenant         Tenant?               @relation(fields: [targetTenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt            DateTime              @default(now()) @map("created_at")
  elevatedScope        RoleElevatedDataScope @relation(fields: [elevatedScopeId], references: [id], onDelete: Restrict)

  @@unique([elevatedScopeId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("sys_role_elevated_data_scope_target")
}

model Session {
  id                String      @id @db.Char(64)
  userId            BigInt      @map("user_id") @db.UnsignedBigInt
  kind              SessionKind @default(AUTHENTICATED)
  expiresAt         DateTime    @map("expires_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  lastSeenAt        DateTime    @default(now()) @map("last_seen_at")
  revokedAt         DateTime?   @map("revoked_at")
  mfaVerifiedAt     DateTime?   @map("mfa_verified_at")
  reauthenticatedAt DateTime?   @map("reauthenticated_at")
  ip                String?     @db.VarChar(64)
  userAgent         String?     @map("user_agent") @db.VarChar(512)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sys_session")
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Char(36)
  traceId       String      @map("trace_id") @db.VarChar(64)
  actorId       BigInt?     @map("actor_id") @db.UnsignedBigInt
  action        String      @db.VarChar(128)
  operationCode String?     @map("operation_code") @db.VarChar(128)
  riskLevel     RiskLevel   @default(L0) @map("risk_level")
  resource      String      @db.VarChar(128)
  method        String      @db.VarChar(16)
  path          String      @db.VarChar(512)
  result        AuditResult
  statusCode    Int         @map("status_code")
  ip            String?     @db.VarChar(64)
  userAgent     String?     @map("user_agent") @db.VarChar(512)
  detail        Json?
  integrityHash String?     @map("integrity") @db.Char(64)
  createdAt     DateTime    @default(now()) @map("created_at")
  actor         User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([traceId])
  @@index([riskLevel, createdAt])
  @@index([operationCode, createdAt])
  @@map("sys_audit_log")
}

model OperationPolicy {
  id                 String                @id @default(uuid()) @db.Char(36)
  operationCode      String                @unique @map("operation_code") @db.VarChar(128)
  name               String                @db.VarChar(128)
  resource           String                @db.VarChar(128)
  action             String                @db.VarChar(64)
  riskLevel          RiskLevel             @default(L1) @map("risk_level")
  minimumRiskLevel   RiskLevel             @default(L1) @map("min_risk_level")
  requireMfa         Boolean               @default(false) @map("require_mfa")
  requireReauth      Boolean               @default(false) @map("require_reauth")
  requireApproval    Boolean               @default(false) @map("require_approval")
  requireDualControl Boolean               @default(false) @map("require_dual_control")
  auditRequired      Boolean               @default(true) @map("audit_required")
  status             OperationPolicyStatus @default(DRAFT)
  version            Int                   @default(1)
  reason             String?               @db.VarChar(255)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@index([status, riskLevel])
  @@map("sys_operation_policy")
}

// Emergency operations are an auditable registration path, not a permission bypass.
// Actor columns intentionally store public UUIDs so records remain useful after account cleanup.
model OpsTicket {
  id                   String               @id @default(uuid()) @db.Char(36)
  ticketNo             String               @unique @map("ticket_no") @db.VarChar(32)
  type                 OpsTicketType
  status               OpsTicketStatus      @default(DRAFT)
  riskLevel            OpsRiskLevel         @map("risk_level")
  title                String               @db.VarChar(160)
  reason               String               @db.VarChar(1000)
  targetType           OpsTargetType        @map("target_type")
  targetId             String?              @map("target_id") @db.VarChar(128)
  offlineBasis         String               @map("offline_basis") @db.VarChar(1000)
  identityVerification String               @map("identity_verification") @db.VarChar(500)
  offlineApprover      String               @map("offline_approver") @db.VarChar(128)
  offlineReviewer      String               @map("offline_reviewer") @db.VarChar(128)
  externalRef          String?              @map("external_ref") @db.VarChar(128)
  requestedBy          String               @map("requested_by") @db.Char(36)
  approvedBy           String?              @map("approved_by") @db.Char(36)
  executedBy           String?              @map("executed_by") @db.Char(36)
  reviewedBy           String?              @map("reviewed_by") @db.Char(36)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  approvedAt           DateTime?            @map("approved_at")
  executedAt           DateTime?            @map("executed_at")
  reviewedAt           DateTime?            @map("reviewed_at")
  closedAt             DateTime?            @map("closed_at")
  evidence             OpsTicketEvidence[]
  executions           OpsTicketExecution[]

  @@index([status, createdAt])
  @@index([type, riskLevel, createdAt])
  @@index([requestedBy, createdAt])
  @@map("sys_ops_ticket")
}

model OpsTicketEvidence {
  id         String          @id @default(uuid()) @db.Char(36)
  ticketId   String          @map("ticket_id") @db.Char(36)
  type       OpsEvidenceType
  name       String          @db.VarChar(255)
  uri        String          @db.VarChar(1024)
  sha256     String?         @db.Char(64)
  uploadedBy String          @map("uploaded_by") @db.Char(36)
  createdAt  DateTime        @default(now()) @map("created_at")
  ticket     OpsTicket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("sys_ops_ticket_evidence")
}

model OpsTicketExecution {
  id                 String             @id @default(uuid()) @db.Char(36)
  ticketId           String             @map("ticket_id") @db.Char(36)
  ticketNo           String             @map("ticket_no") @db.VarChar(32)
  executorUserId     String?            @map("executor_user_id") @db.Char(36)
  operatorOsUser     String             @map("operator_os_user") @db.VarChar(128)
  operatorHost       String             @map("operator_host") @db.VarChar(255)
  operatorIp         String?            @map("operator_ip") @db.VarChar(64)
  dbCurrentUser      String             @map("db_current_user") @db.VarChar(255)
  gitCommit          String?            @map("git_commit") @db.VarChar(128)
  scriptName         String             @map("script_name") @db.VarChar(255)
  scriptVersion      String             @map("script_version") @db.VarChar(128)
  commandHash        String             @map("command_hash") @db.Char(64)
  dryRun             Boolean            @default(false) @map("dry_run")
  result             OpsExecutionResult
  beforeSnapshot     Json?              @map("before_snapshot")
  afterSnapshot      Json?              @map("after_snapshot")
  traceId            String             @map("trace_id") @db.VarChar(64)
  signedAt           DateTime?          @map("signed_at")
  executionSignature String?            @map("execution_signature") @db.Char(64)
  executedAt         DateTime           @default(now()) @map("executed_at")
  ticket             OpsTicket          @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId, executedAt])
  @@map("sys_ops_ticket_execution")
}

// Protected master data: hierarchy links cannot cross a tenant boundary.
model Tenant {
  elevatedTargets RoleElevatedDataScopeTarget[]
  orders          Order[]
  id              String                        @id @default(uuid()) @db.Char(36)
  code            String                        @unique @db.VarChar(64)
  name            String                        @db.VarChar(128)
  status          PermissionStatus              @default(ACTIVE)
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")
  organizations   Organization[]
  departments     Department[]
  users           User[]

  @@map("sys_tenant")
}

model Organization {
  elevatedTargets RoleElevatedDataScopeTarget[]
  id              String                        @id @default(uuid()) @db.Char(36)
  tenantId        String                        @map("tenant_id") @db.Char(36)
  parentId        String?                       @map("parent_id") @db.Char(36)
  code            String                        @db.VarChar(64)
  name            String                        @db.VarChar(128)
  status          PermissionStatus              @default(ACTIVE)
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")
  tenant          Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent          Organization?                 @relation("OrganizationTree", fields: [parentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  children        Organization[]                @relation("OrganizationTree")
  departments     Department[]
  users           User[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([parentId, tenantId])
  @@map("sys_organization")
}

model Department {
  elevatedTargets RoleElevatedDataScopeTarget[]
  id              String                        @id @default(uuid()) @db.Char(36)
  tenantId        String                        @map("tenant_id") @db.Char(36)
  organizationId  String                        @map("organization_id") @db.Char(36)
  parentId        String?                       @map("parent_id") @db.Char(36)
  code            String                        @db.VarChar(64)
  name            String                        @db.VarChar(128)
  status          PermissionStatus              @default(ACTIVE)
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")
  tenant          Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization    Organization                  @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  parent          Department?                   @relation("DepartmentTree", fields: [parentId, tenantId, organizationId], references: [id, tenantId, organizationId], onDelete: Restrict)
  children        Department[]                  @relation("DepartmentTree")
  users           User[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, organizationId])
  @@unique([tenantId, code])
  @@index([parentId, tenantId, organizationId])
  @@index([organizationId, tenantId])
  @@map("sys_department")
}

enum ApprovalKind {
  ROLE_GRANT
  ROLE_STATUS
  ROLE_PERMISSIONS
  API_ROUTE_CHANGE
  API_CREATE
  API_UPDATE
  API_ENABLE
  API_DISABLE
  API_DELETE
  PAGE_ENABLE
  PAGE_DISABLE
  PAGE_ROUTE_CHANGE
  ELEVATED_SCOPE
  ROLE_REVOKE
  ROLE_PERMISSION_REVOKE
  ELEVATED_REVOKE
  MFA_RESET
}

enum ApprovalStatus {
  REQUESTED
  APPROVED
  EXECUTED
  REVIEWED
  CANCELLED
}

// Immutable typed payload, public UUID actors, deliberately no foreign keys.
model ApprovalRequest {
  id                   String         @id @default(uuid()) @db.Char(36)
  requestNo            String         @unique @map("request_no") @db.VarChar(20)
  kind                 ApprovalKind
  status               ApprovalStatus @default(REQUESTED)
  payload              Json
  reason               String         @db.VarChar(255)
  expiresAt            DateTime       @map("expires_at")
  applicantId          String         @map("applicant_id") @db.Char(36)
  applicantDisplayName String?        @map("applicant_display_name") @db.VarChar(128)
  approverId           String?        @map("approver_id") @db.Char(36)
  approverDisplayName  String?        @map("approver_display_name") @db.VarChar(128)
  executorId           String?        @map("executor_id") @db.Char(36)
  executorDisplayName  String?        @map("executor_display_name") @db.VarChar(128)
  reviewerId           String?        @map("reviewer_id") @db.Char(36)
  reviewerDisplayName  String?        @map("reviewer_display_name") @db.VarChar(128)
  approvedAt           DateTime?      @map("approved_at")
  executedAt           DateTime?      @map("executed_at")
  reviewedAt           DateTime?      @map("reviewed_at")
  approvalNote         String?        @map("approval_note") @db.VarChar(255)
  executionNote        String?        @map("execution_note") @db.VarChar(255)
  reviewNote           String?        @map("review_note") @db.VarChar(255)
  cancelledAt          DateTime?      @map("cancelled_at")
  cancellerId          String?        @map("canceller_id") @db.Char(36)
  cancellerDisplayName String?        @map("canceller_display_name") @db.VarChar(128)
  cancellationNote     String?        @map("cancellation_note") @db.VarChar(255)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([applicantId, createdAt])
  @@index([expiresAt])
  @@map("sys_approval_request")
}

// Short-lived, actor-bound references used by the controlled-approval form.
// The raw target UUID is never accepted from the browser as an authority.
model ApprovalTargetRef {
  id          String       @id @default(uuid()) @db.Char(36)
  tokenHash   String       @unique @map("token") @db.Char(64)
  actorUserId String       @map("actor_user_id") @db.Char(36)
  kind        ApprovalKind
  targetType  String       @map("target_type") @db.VarChar(16)
  targetId    String       @map("target_id") @db.Char(36)
  expiresAt   DateTime     @map("expires_at")
  usedAt      DateTime?    @map("used_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([actorUserId, expiresAt])
  @@index([expiresAt])
  @@map("sys_approval_target_ref")
}
